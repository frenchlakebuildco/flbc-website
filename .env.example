# --- Inquiry form (Netlify Function: netlify/functions/inquiry.mjs) ---
# Set these in Netlify: Site configuration -> Environment variables.

# Resend API key (https://resend.com). Required for the form to send email.
RESEND_API_KEY=

# Where inquiries are delivered.
INQUIRY_TO=hello@frenchlakebuild.com

# Sender address. The domain must be verified in Resend (e.g. frenchlakebuild.com).
INQUIRY_FROM=French Lake Build Co. <website@frenchlakebuild.com>

# Optional: Cloudflare Turnstile spam protection. Leave both blank to disable
# (the honeypot field and per-IP rate limit still apply).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
