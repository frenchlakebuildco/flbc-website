---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';
import { work, gallery } from '../lib/work';

// Pre-build viewer-sized images for the full-screen lightbox.
const items = await Promise.all(
  gallery.map(async ({ n, alt }) => {
    const src = work(n);
    const sizes = [1200, 2000].filter((w) => w <= src.width);
    const imgs = await Promise.all(sizes.map((w) => getImage({ src, width: w, format: 'webp', quality: 80 })));
    return {
      n,
      alt,
      src,
      full: imgs[imgs.length - 1].src,
      srcset: imgs.map((im, i) => `${im.src} ${sizes[i]}w`).join(', '),
    };
  }),
);
const count = items.length;
---
<Base
  title="Our Work | French Lake Build Co."
  description="Kitchens, baths and whole-home remodels from across the Twin Cities, designed and built by French Lake Build Co."
  current="work"
>
  <section class="wrap page-intro">
    <div class="page-intro__title">
      <div class="eyebrow">Recent work</div>
      <h1 class="display h1">Our Work</h1>
    </div>
    <p class="intro-text">Kitchens, baths and whole-home remodels from across the Twin Cities.</p>
  </section>

  <section class="wrap gallery-wrap" aria-label="Project photos">
    <ul class="gallery bleed-phone">
      {items.map((it, i) => (
        <li class="tile" data-index={i}>
          <div class="tile__img" data-open={i}>
            <Photo src={it.src} alt={it.alt} sizes="(min-width: 761px) 33vw, (min-width: 481px) 50vw, 100vw" widths={[400, 640, 900, 1200]} eager={i < 3} />
          </div>
          <button type="button" class="tile__btn" data-open={i} aria-label={`View full screen: ${it.alt}`}>
            <span aria-hidden="true">⤢</span>
          </button>
        </li>
      ))}
    </ul>
  </section>

  <CtaBand
    eyebrow="Your project"
    title="Picture your home here"
    text="Share a little about what you have in mind, and you’ll hear from us within one business day."
  />

  <dialog class="lightbox" aria-label="Photo viewer" data-lightbox>
    <div class="lightbox__bar">
      <div class="lightbox__counter" aria-live="polite"><span data-counter>1</span> / {count}</div>
      <button type="button" class="lightbox__close" data-close>Close <span aria-hidden="true">✕</span></button>
    </div>
    <div class="lightbox__stage">
      <button type="button" class="lightbox__nav" data-prev aria-label="Previous photo"><span aria-hidden="true">←</span></button>
      <div class="lightbox__frame">
        <img data-viewer alt="" sizes="(min-width: 768px) calc(100vw - 240px), 100vw" />
      </div>
      <div class="lightbox__hint" aria-hidden="true">Swipe or tap arrows</div>
      <button type="button" class="lightbox__nav" data-next aria-label="Next photo"><span aria-hidden="true">→</span></button>
    </div>
  </dialog>

  <script type="application/json" id="gallery-data" set:html={JSON.stringify(items.map(({ full, srcset, alt }) => ({ full, srcset, alt })))} />
</Base>

<style>
  .intro-text { font-size: 17px; line-height: 1.65; color: var(--text-body); max-width: 40ch; }

  .gallery-wrap { padding-bottom: 96px; }
  .gallery { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .tile { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--sand-deep); }
  .tile__img { width: 100%; height: 100%; cursor: zoom-in; }
  .tile__img :global(.photo) { transition: transform 600ms var(--ease); }
  .tile__btn {
    position: absolute; right: 12px; bottom: 12px;
    width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;
    background: rgba(30, 43, 51, 0.82); color: var(--white); border: none; border-radius: 2px;
    font-size: 18px; line-height: 1; cursor: pointer;
    transition: background-color 140ms var(--ease);
  }
  @media (hover: hover) {
    .tile:hover .tile__img :global(.photo) { transform: scale(1.02); }
    .tile__btn:hover { background: var(--navy); }
    .lightbox__close:hover { background: var(--white); }
    .lightbox__nav:hover { background: var(--navy-hover); }
      }

  /* Lightbox */
  .lightbox {
    position: fixed; inset: 0;
    width: 100vw; height: 100dvh; max-width: none; max-height: none;
    margin: 0; border: 0;
    background: rgba(21, 31, 37, 0.97);
    padding: 28px 40px;
    color: var(--white);
  }
  .lightbox[open] { display: flex; flex-direction: column; gap: 20px; }
  .lightbox::backdrop { background: rgba(21, 31, 37, 0.6); }
  .lightbox__bar { display: flex; justify-content: space-between; align-items: center; }
  .lightbox__counter { font-size: 13px; font-weight: 600; letter-spacing: 0.12em; color: var(--on-dark-muted); }
  .lightbox__close {
    font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    background: var(--sand); color: var(--navy); border: none; border-radius: 2px;
    padding: 12px 18px; min-height: 44px; cursor: pointer; transition: background-color 140ms var(--ease);
  }
  .lightbox__stage {
    flex: 1; min-height: 0;
    display: grid; grid-template-columns: 56px minmax(0, 1fr) 56px; align-items: center; gap: 24px;
  }
  .lightbox__frame { height: 100%; min-height: 0; display: flex; align-items: center; justify-content: center; }
  .lightbox__frame img { width: 100%; height: 100%; object-fit: contain; }
  .lightbox__nav {
    width: 56px; height: 56px; background: transparent; color: var(--white);
    border: 1px solid var(--rule-dark); border-radius: 2px; font-size: 22px; cursor: pointer;
    transition: background-color 140ms var(--ease);
  }

  .lightbox__hint { display: none; }

  @media (max-width: 1080px) {
    .gallery-wrap { padding-bottom: var(--sec); }
  }
  /* Tablet: 2-up; lightbox arrows move into a bar under the image */
  @media (max-width: 760px) {
    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .lightbox { padding: 16px 0 20px; }
    .lightbox__bar { padding-inline: var(--pad); }
    .lightbox__stage {
      grid-template-columns: 56px minmax(0, 1fr) 56px;
      grid-template-rows: minmax(0, 1fr) 56px;
      gap: 20px 12px;
      padding-inline: var(--pad);
    }
    /* Image runs edge to edge; arrows sit in the bar beneath it */
    .lightbox__frame { grid-column: 1 / -1; grid-row: 1; margin-inline: calc(var(--pad) * -1); }
    .lightbox__nav { grid-row: 2; }
    .lightbox__nav[data-prev] { grid-column: 1; }
    .lightbox__nav[data-next] { grid-column: 3; }
    .lightbox__hint {
      display: flex; align-items: center; justify-content: center; grid-row: 2; grid-column: 2;
      font-size: 15px; color: var(--on-dark-muted); text-align: center;
    }
  }
  /* Phone: one column, edge to edge, 8px gap */
  @media (max-width: 480px) {
    .gallery { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .tile__btn { right: 10px; bottom: 10px; }
  }
</style>

<script>
  type Item = { full: string; srcset: string; alt: string };
  const items: Item[] = JSON.parse(document.getElementById('gallery-data')!.textContent || '[]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = dialog.querySelector<HTMLImageElement>('[data-viewer]')!;
  const counter = dialog.querySelector<HTMLElement>('[data-counter]')!;
  let current = 0;
  let opener: HTMLElement | null = null;

  const show = (i: number) => {
    current = (i + items.length) % items.length; // wrap at both ends
    const it = items[current];
    img.srcset = it.srcset;
    img.src = it.full;
    img.alt = it.alt;
    counter.textContent = String(current + 1);
    // Warm the neighbours so arrowing feels instant.
    [current + 1, current - 1].forEach((j) => {
      const n = items[(j + items.length) % items.length];
      const pre = new Image();
      pre.sizes = img.sizes;
      pre.srcset = n.srcset;
    });
  };

  const open = (i: number, from: HTMLElement) => {
    opener = from;
    show(i);
    document.documentElement.style.overflow = 'hidden';
    dialog.showModal();
    dialog.querySelector<HTMLButtonElement>('[data-close]')!.focus();
  };

  const close = () => dialog.close();

  dialog.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    // Return focus to the tile's button that opened the viewer
    const tile = opener?.closest('.tile');
    (tile?.querySelector<HTMLButtonElement>('.tile__btn') ?? opener)?.focus();
  });

  document.querySelectorAll<HTMLElement>('[data-open]').forEach((el) =>
    el.addEventListener('click', () => open(Number(el.dataset.open), el)),
  );
  dialog.querySelector('[data-close]')!.addEventListener('click', close);
  dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1));

  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
    // Escape is handled natively by <dialog>
    if (e.key === 'Tab') {
      // Keep focus inside the viewer
      const f = Array.from(dialog.querySelectorAll<HTMLElement>('button'));
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  // Click on the dark area (not the image or controls) closes
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || (e.target as HTMLElement).classList.contains('lightbox__frame')) close();
  });

  // Swipe on touch devices
  let x0: number | null = null;
  dialog.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  dialog.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    x0 = null;
  });
</script>
