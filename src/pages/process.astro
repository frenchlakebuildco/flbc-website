---
import Base from '../layouts/Base.astro';
import PortalBand from '../components/PortalBand.astro';
import CtaBand from '../components/CtaBand.astro';

const phases = [
  {
    id: 'explore', label: 'Phase one · Explore', tag: 'Complimentary', title: 'Getting acquainted', bg: 'white',
    intro: 'We begin by getting to know you, your home, and what you hope it could become — then share an early vision of what’s possible, and a sense of the investment.',
    stages: [
      ['01', 'Reach out', 'Share a little about your home through our inquiry form, or simply give us a call. You’ll hear from us within one business day.'],
      ['02', 'Complimentary on-site visit', 'We’ll visit your home, take careful measurements, and — most importantly — listen to how you live and what you’d love to change.'],
      ['03', 'Concept presentation', 'Within about two weeks, we’ll meet again to present a draft floor plan, a directional estimate, and a mood board shaped around your style. Together, we’ll walk through the vision, the estimate, and the timeline — and if it feels right, we’ll begin.'],
    ],
  },
  {
    id: 'design', label: 'Phase two · Design & plan', tag: 'Stages 04–05', title: 'Shaping the details', bg: 'sand',
    intro: 'Together, we refine layouts, finishes, and selections, so your plan is complete and fully priced before construction begins.',
    stages: [
      ['04', 'Design agreement', 'Your design agreement reserves your place on our calendar and begins the design work in earnest.'],
      ['05', 'Design & planning', 'This is where your home truly takes shape: material and finish selections, finalized floor plans, interior design and renderings, engineering coordinated with our partners, and walkthroughs with our trades. It all comes together in a completed pre-construction plan.'],
    ],
  },
  {
    id: 'build', label: 'Phase three · Build', tag: 'Stages 06–08', title: 'Building with care', bg: 'white',
    intro: 'The same team that designed your home builds it — keeping you informed each week, with one familiar point of contact throughout.',
    stages: [
      ['06', 'Construction agreement', 'About 60 days before the build phase begins, we’ll present your construction agreement, with every detail and term finalized and clearly laid out.'],
      ['07', 'Construction', 'Every week, you’ll hear from us — what’s been completed, what comes next, and anything we’d like your input on. Your dedicated project manager is always your first call, so you’ll never have to wonder where things stand.'],
      ['08', 'Walkthrough & close-out', 'We’ll walk your finished home together, attend to every last detail, register your appliance warranties, and stand behind our workmanship for a full year.'],
    ],
  },
];

const bar = [
  { id: 'explore', label: 'Explore', sub: 'Stages 01–03 · Complimentary' },
  { id: 'design', label: 'Design & plan', sub: 'Stages 04–05' },
  { id: 'build', label: 'Build', sub: 'Stages 06–08' },
];
---
<Base
  title="Our Process | French Lake Build Co."
  description="Every home we work on moves through the same eight stages. The first three are complimentary, with no obligation to continue — simply a chance to get to know one another."
  current="process"
>
  <section class="wrap page-intro">
    <div class="page-intro__title">
      <div class="eyebrow">Process</div>
      <h1 class="display h1 intro-h1">Three phases, thoughtfully guided</h1>
    </div>
    <p class="lede intro-lede">Every home we work on moves through the same eight stages. The first three are complimentary, with no obligation to continue — simply a chance to get to know one another.</p>
  </section>

  <nav class="wrap phasebar-wrap" aria-label="Process phases">
    <div class="phasebar">
      {bar.map((b) => (
        <a href={`#${b.id}`} class:list={['phasebar__item', `is-${b.id}`]}>
          <span class="phasebar__line" aria-hidden="true"></span>
          <span class="phasebar__text">
            <span class="phasebar__label">{b.label}</span>
            <span class="phasebar__sub">{b.sub}</span>
          </span>
        </a>
      ))}
    </div>
  </nav>

  {phases.map((p) => (
    <section id={p.id} class:list={['phase', `phase--${p.bg}`, `is-${p.id}`]} aria-labelledby={`${p.id}-title`}>
      <div class="wrap phase__inner">
        <div class="phase__intro">
          <span class="phase__rule" aria-hidden="true"></span>
          <div class="phase__meta">
            <span class="phase__label">{p.label}</span>
            <span class="phase__tag">{p.tag}</span>
          </div>
          <h2 class="display h2--38" id={`${p.id}-title`}>{p.title}</h2>
          <p class="phase__lede">{p.intro}</p>
        </div>
        <ol class="stages">
          {p.stages.map(([num, title, text]) => (
            <li class="stage">
              <span class="stage__num" aria-hidden="true">{num}</span>
              <div class="stage__body">
                <h3 class="stage__title"><span class="visually-hidden">Stage {num}: </span>{title}</h3>
                <p class="stage__text">{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  ))}

  <PortalBand
    variant="process"
    eyebrow="During design & build"
    text="Your schedule, selections, approvals, daily progress photos, and payments live in your private Buildertrend portal — on the web or in the app, whenever you’d like to look in."
  />

  <CtaBand
    eyebrow="Thoughtful design. Precision build."
    title="Begin with a conversation"
    text="The first three stages are complimentary, and you’ll hear from us within one business day."
  />
</Base>

<style>
  .intro-h1 { max-width: 18ch; }
  .intro-lede { max-width: 44ch; }

  /* Phase colours */
  .is-explore { --phase: var(--lake); --phase-text: var(--lake-text); }
  .is-design { --phase: var(--brass); --phase-text: var(--brass-text); }
  .is-build { --phase: var(--navy); --phase-text: var(--navy); }

  /* Phase bar */
  .phasebar-wrap { padding-bottom: 88px; }
  .phasebar { display: grid; grid-template-columns: 4fr 2fr 3fr; gap: 8px; }
  .phasebar__item { display: flex; flex-direction: column; gap: 12px; color: var(--navy); }
  .phasebar__line { height: 8px; background: var(--phase); transition: transform 140ms var(--ease); transform-origin: bottom; }
  .phasebar__text { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; }
  .phasebar__label { font-size: 12.5px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--phase-text); }
  .phasebar__sub { font-size: 13.5px; color: var(--text-muted); }

  /* Phase sections */
  .phase { scroll-margin-top: 0; }
  .phase--white { background: var(--white); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .phase--sand { background: var(--sand); }
  .phase__inner {
    padding-top: 88px; padding-bottom: 88px;
    display: grid; grid-template-columns: 440px minmax(0, 1fr); gap: 72px; align-items: start;
  }
  .phase__intro { display: flex; flex-direction: column; gap: 18px; }
  .phase__rule { height: 3px; width: 56px; background: var(--phase); }
  .phase__meta { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
  .phase__label { font-size: 12px; font-weight: 600; letter-spacing: var(--eyebrow-track); text-transform: uppercase; color: var(--phase-text); }
  .phase__tag { font-size: 11.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
  .phase__lede { font-weight: 300; font-size: var(--lede); line-height: 1.6; color: var(--text-lede); }

  .stages { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .stage {
    display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 20px;
    padding: 26px 0; border-top: 1px solid var(--border);
  }
  .stage:last-child { border-bottom: 1px solid var(--border); }
  .stage__num { font-family: var(--font-display); font-size: 30px; line-height: 1; color: var(--phase); }
  .is-design .stage__num { color: var(--brass-text); }
  .stage__body { display: flex; flex-direction: column; gap: 8px; }
  .stage__title { font-family: var(--font-body); font-size: 19px; font-weight: 600; line-height: 1.3; color: var(--navy); }
  .stage__text { font-size: 16.5px; line-height: 1.65; color: var(--text-body); max-width: 62ch; }

  @media (hover: hover) {
    .phasebar__item:hover { color: var(--navy); }
    .phasebar__item:hover .phasebar__line { transform: scaleY(1.5); }
  }

  /* Laptop: 360px intro column + list */
  @media (max-width: 1080px) {
    .phasebar-wrap { padding-bottom: var(--sec); }
    .phase__inner { grid-template-columns: 360px minmax(0, 1fr); gap: 48px; padding-top: var(--sec); padding-bottom: var(--sec); }
  }
  /* Tablet: intro above the stage list; phase bar as drawn (labels may wrap) */
  @media (max-width: 760px) {
    .phasebar__text { gap: 2px 10px; }
    .phase__inner { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .phase__intro { max-width: 600px; gap: 14px; }
  }
  /* Phone: phase bar as three stacked rows (bar + label beneath); 48px number column */
  @media (max-width: 480px) {
    .phasebar { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .phasebar__item { gap: 8px; min-height: 44px; }
    .phasebar__label { letter-spacing: 0.14em; }
    .phasebar__sub { font-size: 13.5px; }
    .phase__inner { gap: 24px; }
    .stage { grid-template-columns: 48px minmax(0, 1fr); gap: 12px; padding: 22px 0; }
    .stage__num { font-size: 26px; }
    .stage__title { font-size: 18px; }
  }
</style>
