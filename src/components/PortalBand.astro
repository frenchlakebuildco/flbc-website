---
interface Props { eyebrow: string; text: string; variant?: 'home' | 'process'; }
const { eyebrow, text, variant = 'home' } = Astro.props;
---
<section class:list={['portal', `portal--${variant}`]}>
  <div class="wrap portal__inner">
    <div class="portal__copy">
      <div class="eyebrow">{eyebrow}</div>
      <h2 class="display h2--band portal__title">Everything about your project, in one place</h2>
      <p class="portal__text">{text}</p>
    </div>
    <div class="portal__badge">
      <div class="portal__label">Client portal powered by</div>
      <a href="https://btrnd.co/badge" target="_blank" rel="noopener">
        <img src="/buildertrend-badge.svg" alt="We work with Buildertrend" width="240" height="80" loading="lazy" />
      </a>
    </div>
  </div>
</section>

<style>
  .portal { background: var(--sand-deep); }
  .portal--home { border-bottom: 1px solid var(--border); }
  .portal__inner { padding-top: 56px; padding-bottom: 56px; display: flex; gap: 52px; align-items: center; }
  .portal--process .portal__inner { padding-top: 64px; padding-bottom: 64px; gap: 56px; }
  .portal__copy { flex: 1; display: flex; flex-direction: column; gap: 16px; }
  .portal--process .portal__copy { gap: 14px; }
  .portal--home .portal__title { max-width: 26ch; }
  .portal__text { font-size: 17px; line-height: 1.65; color: var(--text-body); max-width: 52ch; }
  .portal--process .portal__text { max-width: 60ch; }
  .portal__badge { width: 320px; flex: none; display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .portal__label {
    width: 240px; text-align: center;
    font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-muted);
  }
  .portal__badge a { display: block; width: 240px; }
  .portal__badge img { width: 240px; height: 80px; }

  @media (max-width: 1080px) {
    .portal__inner, .portal--process .portal__inner { gap: 40px; }
    .portal__badge { width: 260px; }
  }
  /* Tablet & phone: stacked, badge below the copy, left-aligned */
  @media (max-width: 760px) {
    .portal__inner, .portal--process .portal__inner {
      flex-direction: column; align-items: flex-start; gap: 28px;
      padding-top: var(--sec); padding-bottom: var(--sec);
    }
    .portal__badge { width: auto; }
    .portal__label { width: auto; text-align: left; }
    .portal__text { font-size: 16.5px; }
  }
</style>
