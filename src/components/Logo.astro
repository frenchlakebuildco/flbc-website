---
/**
 * FLBC horizontal lockup — matches designs/assets/logo/flbc-lockup-h-color.svg.
 * Rendered as inline SVG mark + live text so it uses the self-hosted webfonts.
 */
interface Props { size?: 'header' | 'footer'; }
const { size = 'header' } = Astro.props;
---
<a href="/" class:list={['logo', `logo--${size}`]} aria-label="French Lake Build Co. — home">
  <svg class="logo__mark" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <defs><clipPath id={`flbc-clip-${size}`}><circle cx="50" cy="50" r="41.67" /></clipPath></defs>
    <circle cx="50" cy="50" r="48.61" fill="none" stroke="#1E2B33" stroke-width="3.2" />
    <g clip-path={`url(#flbc-clip-${size})`}>
      <rect x="0" y="0" width="100" height="54.3" fill="#B08D57" />
      <rect x="0" y="57.63" width="100" height="42.37" fill="#1E2B33" />
    </g>
  </svg>
  <span class="logo__text">
    <span class="logo__name">French Lake Build Co.</span>
    <span class="logo__tag" aria-hidden="true">
      <span>Design</span><i></i><span>Build</span><i></i><span>Renovate</span>
    </span>
  </span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; color: var(--navy); }
  .logo:hover { color: var(--navy); }
  .logo__mark { width: 46px; height: 46px; flex: none; }
  .logo__text { display: flex; flex-direction: column; align-items: flex-start; gap: 7px; }
  .logo__name { font-family: var(--font-display); font-size: 22px; line-height: 1; white-space: nowrap; }
  .logo__tag {
    display: flex; align-items: center; gap: 7px;
    font-size: 9.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--text-muted); white-space: nowrap; line-height: 1.2;
  }
  .logo__tag i { width: 1px; height: 9px; background: var(--brass); }

  .logo--footer .logo__mark { width: 42px; height: 42px; }
  .logo--footer .logo__name { font-size: 20px; }
  .logo--footer .logo__tag { font-size: 9px; }
  .logo--footer .logo__tag i { height: 8px; }

  @media (max-width: 420px) {
    .logo--header { gap: 9px; }
    .logo--header .logo__mark { width: 36px; height: 36px; }
    .logo--header .logo__name { font-size: 17px; }
    .logo--header .logo__tag { font-size: 8.5px; gap: 6px; }
  }
</style>
