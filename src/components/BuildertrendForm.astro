---
/**
 * Project inquiry — Buildertrend lead capture form (embedded).
 * Used on Home and Start a Project. Submissions go straight into Buildertrend
 * as leads (with photos); Buildertrend handles validation, spam protection
 * (Google reCAPTCHA) and notifications.
 *
 * The fields, labels and required settings are managed in Buildertrend, not here.
 * The form runs inside an iframe served by buildertrend.net, so its inner styling
 * can't be changed from this site.
 */
interface Props { lazy?: boolean; }
const { lazy = false } = Astro.props;

// Public embed ID from Buildertrend (identifies the French Lake Build Co. account; not a secret).
const BT_FORM_URL =
  'https://buildertrend.net/contact-form/?builderID=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJidWlsZGVySWQiOjExNTQzMH0.djqeJTCwNKKhAFXUNlQthKsgCmMK2BTaCZyme1djFlU';
---
<div class="bt-panel">
  <div class="bt-panel__head">
    <h3 class="bt-panel__title">Project inquiry</h3>
    <div class="bt-panel__req"><span aria-hidden="true">*</span> Required</div>
  </div>
  <p class="bt-panel__note">Please include a few photos of your current space. They help us assess your project before our first call.</p>

  <!-- Buildertrend Contact Form -->
  <script is:inline type="text/javascript" src="https://buildertrend.net/contact-form/btClientContactForm.js"></script>
  <iframe
    src={BT_FORM_URL}
    id="btIframe"
    title="Project inquiry form"
    scrolling="no"
    loading={lazy ? 'lazy' : 'eager'}
    class="bt-panel__frame"
    style="background:transparent;border:0px;margin:0 auto;width:100%;"
  ></iframe>
  <!-- /Buildertrend Contact Form -->

  <p class="bt-panel__fallback">
    Trouble with the form? Call <a href="tel:+19523338665">952-333-8665</a> or email <a href="mailto:hello@frenchlakebuild.com">hello@frenchlakebuild.com</a>.
  </p>
</div>

<style>
  .bt-panel {
    width: 620px;
    flex: none;
    background: var(--white);
    padding: 36px 26px 28px; /* Buildertrend adds 14px inside the frame → fields line up at 40px */
    color: var(--navy);
    display: flex;
    flex-direction: column;
  }
  .bt-panel__head, .bt-panel__note, .bt-panel__fallback { margin-inline: 14px; }
  .bt-panel__head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .bt-panel__title {
    font-family: var(--font-body); font-size: 12px; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-muted); line-height: normal;
  }
  .bt-panel__req { font-size: 13px; color: var(--text-muted); }
  .bt-panel__req span { color: var(--brass-text); }
  .bt-panel__note {
    margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border);
    font-size: 15.5px; line-height: 1.55; color: var(--text-body);
  }
  /* Height is set by Buildertrend's script once the form loads; this avoids a jump before that */
  .bt-panel__frame { display: block; min-height: 1100px; margin-top: 4px; }
  .bt-panel__fallback {
    margin-top: 8px; padding-top: 16px; border-top: 1px solid var(--border);
    font-size: 14.5px; line-height: 1.55; color: var(--text-muted);
  }
  .bt-panel__fallback a { color: var(--lake-text); text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 1080px) {
    .bt-panel { width: 100%; }
  }
  @media (max-width: 760px) {
    .bt-panel__note { font-size: 16.5px; }
    .bt-panel__fallback { font-size: 16.5px; }
  }
  /* Phone: full-bleed panel; Buildertrend's own 14px padding gives the 20px edge */
  @media (max-width: 480px) {
    .bt-panel { padding: 28px 6px 32px; }
  }
</style>
