---
import Logo from './Logo.astro';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo size="footer" />
        <div class="site-footer__tagline">Thoughtful design. Precision build.</div>
        <p class="site-footer__blurb">Design and build for thoughtful remodels and additions across the greater Twin Cities.</p>
      </div>
      <div class="site-footer__cols">
        <nav class="site-footer__col" aria-label="Footer">
          <a href="/our-work">Our Work</a>
          <a href="/process">Our Process</a>
          <a href="/start-a-project">Contact</a>
        </nav>
        <div class="site-footer__col">
          <span>Based in Dayton, MN</span>
          <span class="site-footer__call">Call or text <a href="tel:+19523338665">952-333-8665</a></span>
          <a href="https://www.instagram.com/frenchlakebuildco/" target="_blank" rel="noopener">Instagram</a>
        </div>
      </div>
    </div>
    <div class="site-footer__bottom">
      <div class="site-footer__legal"><span>© 2026 French Lake Build Co.</span><span>MN Lic. BC810479</span><span class="site-footer__area">Serving homeowners across the greater Twin Cities</span></div>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--sand); border-top: 1px solid var(--border); }
  .site-footer > .wrap { padding-top: 56px; padding-bottom: 28px; display: flex; flex-direction: column; gap: 44px; }
  .site-footer__top { display: flex; gap: 64px; }
  .site-footer__brand { width: 300px; flex: none; display: flex; flex-direction: column; gap: 16px; }
  .site-footer__tagline { font-family: var(--font-display); font-size: 21px; line-height: 1.25; padding-top: 6px; }
  .site-footer__blurb { font-size: 15.5px; line-height: 1.6; color: var(--text-body); }
  .site-footer__cols { flex: 1; display: flex; gap: 64px; padding-top: 4px; }
  .site-footer__col { display: flex; flex-direction: column; gap: 12px; font-size: 15.5px; color: var(--text-body); }
  .site-footer__col a { color: var(--text-body); }
  .site-footer__bottom {
    display: flex; align-items: center; gap: 16px;
    padding-top: 22px; border-top: 1px solid var(--border);
    font-size: 11.5px; font-weight: 500; letter-spacing: 0.06em; color: var(--text-muted);
  }
  .site-footer__legal { display: flex; gap: 26px; flex-wrap: wrap; }
  .site-footer__area { display: none; }
  .site-footer__call a { color: var(--text-body); text-decoration: underline; text-decoration-color: var(--border); text-underline-offset: 3px; }
  @media (hover: hover) {
    .site-footer__col a:hover { color: var(--navy); }
  }

  @media (max-width: 1080px) {
    .site-footer__top { gap: 48px; }
    .site-footer__cols { gap: 40px; }
  }
  /* Tablet: 2 columns, brand block spans both */
  @media (max-width: 760px) {
    .site-footer > .wrap { padding-top: 48px; gap: 36px; }
    .site-footer__top { display: grid; grid-template-columns: 1fr 1fr; gap: 36px 24px; }
    .site-footer__brand { width: auto; grid-column: 1 / -1; }
    .site-footer__cols { display: contents; }
    .site-footer__col { font-size: 16.5px; gap: 4px; }
    .site-footer__col > a, .site-footer__col > span { min-height: 44px; display: flex; align-items: center; }
    .site-footer__call { gap: 4px; flex-wrap: wrap; }
    .site-footer__blurb { font-size: 16.5px; }
    .site-footer__area { display: inline; }
  }
  /* Phone: one column, license and service area at the bottom */
  @media (max-width: 480px) {
    .site-footer__top { grid-template-columns: 1fr; gap: 28px; }
    .site-footer__bottom { flex-direction: column; align-items: flex-start; gap: 4px; }
    .site-footer__legal { flex-direction: column; gap: 6px; }
  }
</style>
