---
import Logo from './Logo.astro';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo size="footer" />
        <div class="site-footer__tagline">Thoughtful design. Precision build.</div>
        <p class="site-footer__blurb">Design and build for thoughtful remodels and additions across the greater Twin Cities.</p>
      </div>
      <div class="site-footer__cols">
        <div class="site-footer__col">
          <h2 class="site-footer__heading">Work</h2>
          <a href="/our-work">Our Work</a>
          <a href="/process">Process</a>
        </div>
        <div class="site-footer__col">
          <h2 class="site-footer__heading">Firm</h2>
          <a href="/start-a-project">Contact</a>
        </div>
        <div class="site-footer__col">
          <h2 class="site-footer__heading">Contact</h2>
          <span>Based in Dayton, MN</span>
          <a href="tel:+19523338665">952-333-8665</a>
        </div>
      </div>
    </div>
    <div class="site-footer__bottom">
      <div class="site-footer__legal"><span>© 2026 French Lake Build Co.</span><span>MN Lic. BC810479</span></div>
      <div><a href="https://www.instagram.com/frenchlakebuildco/" target="_blank" rel="noopener">Instagram</a></div>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--sand); border-top: 1px solid var(--border); }
  .site-footer > .wrap { padding-top: 56px; padding-bottom: 28px; display: flex; flex-direction: column; gap: 44px; }
  .site-footer__top { display: flex; gap: 64px; }
  .site-footer__brand { width: 300px; flex: none; display: flex; flex-direction: column; gap: 16px; }
  .site-footer__tagline { font-family: var(--font-display); font-size: 21px; line-height: 1.25; padding-top: 6px; }
  .site-footer__blurb { font-size: 15.5px; line-height: 1.6; color: var(--text-body); }
  .site-footer__cols { flex: 1; display: flex; gap: 52px; }
  .site-footer__col { display: flex; flex-direction: column; gap: 12px; font-size: 15.5px; color: var(--text-body); }
  .site-footer__col a { color: var(--text-body); }
  .site-footer__col a:hover { color: var(--navy); }
  .site-footer__heading {
    font-family: var(--font-body); font-size: 11px; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--navy); line-height: 1.4;
  }
  .site-footer__bottom {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding-top: 22px; border-top: 1px solid var(--border);
    font-size: 11.5px; font-weight: 500; letter-spacing: 0.06em; color: var(--text-muted);
  }
  .site-footer__legal { display: flex; gap: 26px; flex-wrap: wrap; }
  .site-footer__bottom a { color: var(--text-body); }
  .site-footer__bottom a:hover { color: var(--navy); }

  @media (max-width: 1199px) {
    .site-footer__top { flex-direction: column; gap: 40px; }
  }
  @media (max-width: 767px) {
    .site-footer__cols { flex-direction: column; gap: 32px; }
    .site-footer__col a { min-height: 44px; display: flex; align-items: center; margin-block: -10px; }
    .site-footer__bottom { flex-direction: column; align-items: flex-start; }
    .site-footer__legal { gap: 8px 26px; }
    .site-footer__bottom a { display: inline-flex; min-height: 44px; align-items: center; }
  }
</style>
